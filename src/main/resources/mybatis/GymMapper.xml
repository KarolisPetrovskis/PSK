<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.GymMapper">

    <resultMap id="BaseResultMap" type="Gym">
        <id column="ID" property="id" />
        <result column="NAME" property="name" />
    </resultMap>

    <resultMap id="GymWithTrainersResultMap" type="Gym" extends="BaseResultMap">
        <collection property="trainers" column="ID" select="mybatis.TrainerMapper.selectByGym" />
    </resultMap>

    <delete id="deleteByPrimaryKey" parameterType="long">
        delete from GYM where ID = #{id}
    </delete>

    <insert id="insert" keyColumn="ID" keyProperty="id" useGeneratedKeys="true">
        insert into GYM (NAME) values (#{name})
    </insert>

    <update id="updateByPrimaryKey" parameterType="Gym">
        update GYM set NAME = #{name} where ID = #{id}
    </update>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        select ID, NAME from GYM where ID = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        select ID, NAME from GYM
    </select>

    <select id="selectAllWithTrainers" resultMap="GymWithTrainersResultMap">
        select ID, NAME from GYM order by ID
    </select>

</mapper>