<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.TrainerMapper">

    <resultMap id="BaseResultMap" type="Trainer">
        <id column="ID" property="id" />
        <result column="NAME" property="name" />
        <!-- GYM_ID will be mapped to gym.id via setter -->
        <result column="GYM_ID" property="gym.id" />
    </resultMap>

    <delete id="deleteByPrimaryKey" parameterType="long">
        delete from TRAINER where ID = #{id}
    </delete>

    <insert id="insert" keyColumn="ID" keyProperty="id" useGeneratedKeys="true">
        insert into TRAINER (NAME, GYM_ID) values (#{name}, #{gym.id})
    </insert>

    <update id="updateByPrimaryKey" parameterType="Trainer">
        update TRAINER set NAME = #{name}, GYM_ID = #{gym.id} where ID = #{id}
    </update>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        select ID, NAME, GYM_ID from TRAINER where ID = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        select ID, NAME, GYM_ID from TRAINER
    </select>

    <select id="findByGymId" resultMap="BaseResultMap">
        select ID, NAME, GYM_ID from TRAINER where GYM_ID = #{gymId}
    </select>

    <select id="findByNameAndGym" resultMap="BaseResultMap">
        select ID, NAME, GYM_ID from TRAINER
        where NAME = #{name} and GYM_ID = #{gymId}
    </select>

    <select id="selectByGym" resultMap="BaseResultMap">
        select ID, NAME, GYM_ID from TRAINER where GYM_ID = #{gymId}
    </select>

</mapper>